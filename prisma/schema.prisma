generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OutboxStatus {
  pending
  processing
  accepted_by_adapter
  failed

  @@map("community_outbox_status")
}

enum AdapterDeliveryStatus {
  accepted
  processing
  sent
  failed

  @@map("discord_adapter_delivery_status")
}

enum DiscordMessageMediaKind {
  attachment
  embed
  sticker

  @@map("discord_message_media_kind")
}

model OutboxEvent {
  id                String       @id @db.Uuid
  eventType         String       @map("event_type")
  schemaVersion     Int          @map("schema_version")
  aggregateType     String       @map("aggregate_type")
  aggregateId       String       @map("aggregate_id")
  destination       String
  payload           Json
  status            OutboxStatus @default(pending)
  attemptCount      Int          @default(0) @map("attempt_count")
  nextAttemptAt     DateTime     @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  leaseOwner        String?      @map("lease_owner")
  leaseExpiresAt    DateTime?    @map("lease_expires_at") @db.Timestamptz(6)
  lastErrorCode     String?      @map("last_error_code")
  lastErrorMessage  String?      @map("last_error_message")
  acceptedAt        DateTime?    @map("accepted_at") @db.Timestamptz(6)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([destination, nextAttemptAt, createdAt], map: "outbox_event_ready_idx")
  @@map("community_outbox_event")
}

model AdapterDelivery {
  id               String                @id @default(uuid()) @db.Uuid
  eventId          String                @unique @map("event_id") @db.Uuid
  botId            String?               @map("bot_id")
  payload          Json
  status           AdapterDeliveryStatus @default(accepted)
  acceptedAt       DateTime              @map("accepted_at") @db.Timestamptz(6)
  attemptCount     Int                   @default(0) @map("attempt_count")
  nextAttemptAt    DateTime?             @map("next_attempt_at") @db.Timestamptz(6)
  lastErrorCode    String?               @map("last_error_code")
  lastErrorMessage String?               @map("last_error_message")
  sentAt           DateTime?             @map("sent_at") @db.Timestamptz(6)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([botId, status, nextAttemptAt, createdAt], map: "adapter_delivery_ready_idx")
  @@map("discord_adapter_delivery")
}

model DiscordBotRegistration {
  botId            String    @id @map("bot_id")
  token            String    @map("token")
  settings         Json      @default("{}")
  discordUserId    String?   @map("discord_user_id")
  isActive         Boolean   @default(true) @map("is_active")
  rotatedAt        DateTime? @map("rotated_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  audits           DiscordBotAdminAudit[]

  @@map("discord_bot_registration")
}

model DiscordGuild {
  id        String   @id @map("guild_id")
  name      String   @map("name")
  icon      String?  @map("icon")
  ownerId              String?  @map("owner_id")
  lastFullSyncAt       DateTime? @map("last_full_sync_at") @db.Timestamptz(6)
  lastFullSyncFailedAt DateTime? @map("last_full_sync_failed_at") @db.Timestamptz(6)
  lastFullSyncError    String?  @map("last_full_sync_error")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  channels  DiscordChannel[]
  roles     DiscordRole[]
  messages  DiscordMessage[]
  members   DiscordGuildMember[]

  @@map("discord_guild")
}

model DiscordUser {
  id            String   @id @map("user_id")
  username      String   @map("username")
  discriminator String?  @map("discriminator")
  globalName    String?  @map("global_name")
  avatar        String?  @map("avatar")
  isBot         Boolean  @default(false) @map("is_bot")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  messages      DiscordMessage[]
  members       DiscordGuildMember[]

  @@map("discord_user")
}

model DiscordChannel {
  id          String   @id @map("channel_id")
  guildId     String?  @map("guild_id")
  name        String   @map("name")
  type        Int      @map("type")
  topic       String?  @map("topic")
  position    Int      @default(0) @map("position")
  parentId    String?  @map("parent_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  guild       DiscordGuild? @relation(fields: [guildId], references: [id], onDelete: Cascade)
  messages    DiscordMessage[]

  @@index([guildId], map: "discord_channel_guild_idx")
  @@map("discord_channel")
}

model DiscordRole {
  id          String   @id @map("role_id")
  guildId     String   @map("guild_id")
  name        String   @map("name")
  color       Int      @default(0) @map("color")
  hoist       Boolean  @default(false) @map("hoist")
  position    Int      @default(0) @map("position")
  permissions String   @map("permissions")
  managed     Boolean  @default(false) @map("managed")
  mentionable Boolean  @default(false) @map("mentionable")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  guild       DiscordGuild        @relation(fields: [guildId], references: [id], onDelete: Cascade)
  memberRoles DiscordMemberRole[]

  @@index([guildId], map: "discord_role_guild_idx")
  @@map("discord_role")
}

model DiscordMessage {
  id        String   @id @map("message_id")
  channelId String   @map("channel_id")
  guildId   String?  @map("guild_id")
  authorId  String   @map("author_id")
  content   String   @map("content")
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  guild     DiscordGuild?        @relation(fields: [guildId], references: [id], onDelete: Cascade)
  channel   DiscordChannel       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author    DiscordUser          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  media     DiscordMessageMedia[]

  @@index([guildId, channelId], map: "discord_message_channel_idx")
  @@index([authorId], map: "discord_message_author_idx")
  @@map("discord_message")
}

model DiscordMessageMedia {
  id          String                  @id @default(uuid()) @db.Uuid
  messageId   String                  @map("message_id")
  kind        DiscordMessageMediaKind
  position    Int
  sourceId    String?                 @map("source_id")
  label       String
  url         String?
  contentType String?                 @map("content_type")
  sizeBytes   Int?                    @map("size_bytes")
  width       Int?
  height      Int?
  description String?
  isSpoiler   Boolean                 @default(false) @map("is_spoiler")
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  message DiscordMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, kind, position], map: "discord_message_media_position_key")
  @@index([messageId], map: "discord_message_media_message_idx")
  @@map("discord_message_media")
}

model DiscordGuildMember {
  guildId   String   @map("guild_id")
  userId    String   @map("user_id")
  nickname  String?  @map("nickname")
  joinedAt  DateTime? @map("joined_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  guild     DiscordGuild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user      DiscordUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles     DiscordMemberRole[]

  @@id([guildId, userId])
  @@index([userId], map: "discord_guild_member_user_idx")
  @@map("discord_guild_member")
}

model DiscordMemberRole {
  guildId   String @map("guild_id")
  userId    String @map("user_id")
  roleId    String @map("role_id")

  member    DiscordGuildMember @relation(fields: [guildId, userId], references: [guildId, userId], onDelete: Cascade)
  role      DiscordRole        @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([guildId, userId, roleId])
  @@index([roleId], map: "discord_member_role_role_idx")
  @@map("discord_member_role")
}

model DiscordBotAdminAudit {
  id        String   @id @default(uuid()) @db.Uuid
  botId     String   @map("bot_id")
  actorId   String   @map("actor_id")
  action    String
  details   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  bot DiscordBotRegistration @relation(fields: [botId], references: [botId], onDelete: Restrict)

  @@index([botId, createdAt], map: "discord_bot_admin_audit_bot_created_idx")
  @@index([actorId, createdAt], map: "discord_bot_admin_audit_actor_created_idx")
  @@map("discord_bot_admin_audit")
}

model WebUser {
  id        String   @id @default(uuid()) @map("user_id")
  email     String   @unique @map("email")
  name      String   @map("name")
  password  String   @map("password")
  roles     String[] @map("roles")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("web_user")
}
