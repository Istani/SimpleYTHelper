# Generate a long random value; never commit real secrets.
WEB_AUTH_SECRET=replace-with-at-least-32-random-characters
# Initial bootstrap accounts. Replace this ENV provider with identity-api before public deployment.
WEB_USERS_JSON=[{"id":"admin-1","email":"admin@example.invalid","name":"Admin","roles":["admin","creator","viewer"],"password":"replace-me"},{"id":"creator-1","email":"creator@example.invalid","name":"Creator","roles":["creator","viewer"],"password":"replace-me"},{"id":"viewer-1","email":"viewer@example.invalid","name":"Viewer","roles":["viewer"],"password":"replace-me"}]
# Keep true behind HTTPS. Set false only for an HTTP-only local smoke test.
WEB_COOKIE_SECURE=true
# Database connection URL for PostgreSQL
DATABASE_URL=postgresql://postgres:password@postgres:5432/postgres?schema=public
# Discord OAuth application settings. Register this exact callback URL in Discord Developer Portal.
DISCORD_OAUTH_CLIENT_ID=replace-with-discord-application-client-id
DISCORD_OAUTH_CLIENT_SECRET=replace-with-discord-application-client-secret
DISCORD_OAUTH_REDIRECT_URI=https://simpleyth.example.invalid/api/connections/discord/callback
# Generate with: openssl rand -base64 32. This encrypts OAuth tokens at rest; never rotate without a re-encryption plan.
OAUTH_TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
# Internal adapter bearer token for outbox / inter-service communication
INTERNAL_ADAPTER_TOKEN=replace-with-secure-internal-adapter-token
