<h2>{{i18n "API-Administration"}}</h2>
<p>{{i18n "Bestehende System-Admins haben automatisch API-Admin-Zugriff. API-Admins können mit ?userId= alle SYTH-Accountdaten abfragen und werden nicht limitiert oder berechnet."}}</p>
<table class="data-table">
  <tr><th>{{i18n "ID"}}</th><th>{{i18n "E-Mail"}}</th><th>{{i18n "System Admin"}}</th><th>{{i18n "API Admin"}}</th><th>{{i18n "Action"}}</th></tr>
  {{#each data.users}}
  <tr>
    <td>{{id}}</td><td>{{user}}</td><td>{{#if is_admin}}{{i18n "Yes"}}{{else}}{{i18n "No"}}{{/if}}</td><td>{{#if is_api_admin}}{{i18n "Yes"}}{{else}}{{i18n "No"}}{{/if}}</td>
    <td><form method="POST" action="/Admin/Api/{{id}}"><input type="hidden" name="csrf_token" value="{{../data.csrf_token}}"><select name="is_api_admin"><option value="0">{{i18n "Revoke"}}</option><option value="1">{{i18n "Grant"}}</option></select><input type="submit" value="{{i18n "Save"}}"></form></td>
  </tr>
  {{/each}}
</table>

<h3>{{i18n "API-Nutzung und Quotas"}}</h3><p>{{i18n "Übersicht aller protokollierten API-Requests. Ein Quota-Limit ist aktuell nicht konfiguriert."}}</p>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 10px; margin-bottom: 15px;"><div class="ui-state-highlight ui-corner-all" style="padding: 10px;"><strong>{{i18n "Requests gesamt"}}</strong><br>{{formatNumber data.usage.total_requests}}</div><div class="ui-state-highlight ui-corner-all" style="padding: 10px;"><strong>{{i18n "Letzte 24 Stunden"}}</strong><br>{{formatNumber data.usage.requests_last_24h}}</div><div class="ui-state-highlight ui-corner-all" style="padding: 10px;"><strong>{{i18n "Letzte 30 Tage"}}</strong><br>{{formatNumber data.usage.requests_last_30d}}</div><div class="ui-state-highlight ui-corner-all" style="padding: 10px;"><strong>{{i18n "Ø Antwortzeit"}}</strong><br>{{formatNumber data.usage.avg_duration_ms}} ms</div></div>
<h4>{{i18n "Nutzung nach Endpunkt"}}</h4><table class="data-table"><tr><th>{{i18n "Endpunkt"}}</th><th>{{i18n "Requests"}}</th><th>{{i18n "Ø Antwortzeit"}}</th><th>{{i18n "Antwortdaten"}}</th></tr>{{#each data.usage.by_endpoint}}<tr><td><code>{{endpoint}}</code></td><td>{{formatNumber requests}}</td><td>{{formatNumber avg_duration_ms}} ms</td><td>{{formatNumber response_bytes}} Bytes</td></tr>{{else}}<tr><td colspan="4">{{i18n "Noch keine API-Requests protokolliert."}}</td></tr>{{/each}}</table>
<h4>{{i18n "Nutzung nach API-Key"}}</h4><table class="data-table"><tr><th>{{i18n "Account"}}</th><th>{{i18n "Key"}}</th><th>{{i18n "Requests"}}</th><th>{{i18n "Letzte Nutzung"}}</th></tr>{{#each data.usage.by_key}}<tr><td>{{user}}</td><td><code>{{key_prefix}}…</code></td><td>{{formatNumber requests}}</td><td>{{formatDateTime last_request_at}}</td></tr>{{else}}<tr><td colspan="4">{{i18n "Noch keine API-Requests protokolliert."}}</td></tr>{{/each}}</table>
