<h2>{{{i18n "API-Administration"}}}</h2>
<p>{{{i18n "Bestehende System-Admins haben automatisch API-Admin-Zugriff. API-Admins können mit ?userId= alle SYTH-Accountdaten abfragen und werden nicht limitiert oder berechnet."}}}</p>
<table>
  <tr><th>{{i18n "ID"}}</th><th>{{i18n "E-Mail"}}</th><th>{{i18n "System Admin"}}</th><th>{{i18n "API Admin"}}</th><th>{{i18n "Action"}}</th></tr>
  {{#each data.users}}
  <tr>
    <td>{{id}}</td><td>{{user}}</td><td>{{#if is_admin}}{{i18n "Yes"}}{{else}}{{i18n "No"}}{{/if}}</td><td>{{#if is_api_admin}}{{i18n "Yes"}}{{else}}{{i18n "No"}}{{/if}}</td>
    <td><form method="POST" action="/Admin/Api/{{id}}"><input type="hidden" name="csrf_token" value="{{../data.csrf_token}}"><select name="is_api_admin"><option value="0">{{i18n "Revoke"}}</option><option value="1">{{i18n "Grant"}}</option></select><input type="submit" value="{{i18n "Save"}}"></form></td>
  </tr>
  {{/each}}
</table>
