<main class="api-docs-page">
  <section class="page-heading"><p class="eyebrow">{{i18n "Developer"}}</p><h1>SimpleYTH Account API</h1><p>{{i18n "Greife aus eigenen Tools auf Content-, Community- und Analytics-Daten deines Accounts zu."}}</p></section>
  <section class="card api-docs-intro"><h2>{{i18n "Schnellstart"}}</h2><ol class="steps"><li>{{i18n "Erstelle unter"}} <a href="/Api">{{i18n "API-Keys"}}</a> {{i18n "einen Key mit einer eindeutigen Bezeichnung."}}</li><li>{{i18n "Übermittle den Key ausschließlich im Request-Header."}}</li><li>{{i18n "Rufe einen Endpoint unter"}} <code>/api/v1</code> {{i18n "auf."}}</li></ol><pre><code>curl -H "X-SYTH-API-Key: YOUR_API_KEY"   "https://DEINE-DOMAIN/api/v1/channels"</code></pre></section>
  <section class="card table-wrap"><h2>{{i18n "Endpoints"}}</h2><table class="data-table"><thead><tr><th>{{i18n "Methode"}}</th><th>{{i18n "Pfad"}}</th><th>{{i18n "Beschreibung"}}</th></tr></thead><tbody><tr><td><span class="http-method">GET</span></td><td><code>/me</code></td><td>{{i18n "Accountdaten ohne Passwortinformationen"}}</td></tr><tr><td><span class="http-method">GET</span></td><td><code>/channels</code></td><td>{{i18n "Verbundene Channels"}}</td></tr><tr><td><span class="http-method">GET</span></td><td><code>/members</code></td><td>{{i18n "Community-Mitglieder"}}</td></tr><tr><td><span class="http-method">GET</span></td><td><code>/videos</code></td><td>{{i18n "Videos, neueste zuerst"}}</td></tr><tr><td><span class="http-method">GET</span></td><td><code>/playlists</code></td><td>{{i18n "Gespeicherte Playlists"}}</td></tr><tr><td><span class="http-method">GET</span></td><td><code>/analytics/channels</code></td><td>{{i18n "Neueste Kanal-Snapshots"}}</td></tr><tr><td><span class="http-method">GET</span></td><td><code>/analytics/videos</code></td><td>{{i18n "Neueste Video-Snapshots"}}</td></tr><tr><td><span class="http-method">GET</span></td><td><code>/rpg/characters</code></td><td>{{i18n "Charaktere inklusive Inventar"}}</td></tr></tbody></table></section>
  <section class="api-docs-grid"><section class="card"><h2>{{i18n "Authentifizierung"}}</h2><p>{{i18n "Nutze einen der folgenden Header:"}}</p><pre><code>X-SYTH-API-Key: YOUR_API_KEY
Authorization: Bearer YOUR_API_KEY</code></pre><p>{{i18n "Ein Key darf nur auf Daten des zugehörigen Accounts zugreifen."}}</p></section><section class="card"><h2>{{i18n "Antwortformat"}}</h2><p>{{i18n "Erfolgreiche Antworten enthalten"}} <code>data</code> {{i18n "und"}} <code>meta</code>.</p><pre><code>{
  "data": [],
  "meta": { "requestedUserId": 123 }
}</code></pre></section></section>
  <section class="card"><h2>{{i18n "Admin-Abfragen und Fehler"}}</h2><p>{{i18n "API-Administratoren können mit"}} <code>?userId=123</code> {{i18n "einen anderen Account abfragen. Für normale Keys ist nur die eigene User-ID zulässig."}}</p><table class="data-table"><thead><tr><th>Status</th><th>{{i18n "Fehlercode"}}</th><th>{{i18n "Bedeutung"}}</th></tr></thead><tbody><tr><td>401</td><td><code>missing_api_key</code></td><td>{{i18n "Kein Key wurde mitgesendet."}}</td></tr><tr><td>401</td><td><code>invalid_api_key</code></td><td>{{i18n "Der Key ist ungültig oder widerrufen."}}</td></tr><tr><td>403</td><td><code>forbidden_user_scope</code></td><td>{{i18n "Der Key darf diesen Account nicht abfragen."}}</td></tr><tr><td>404</td><td><code>user_not_found</code></td><td>{{i18n "Die angefragte User-ID existiert nicht."}}</td></tr></tbody></table></section>
</main>
