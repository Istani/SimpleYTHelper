<section class="page-heading"><p class="eyebrow">Performance</p><h1>Analytics</h1><p>Aktuelle Snapshots deiner verbundenen Kanäle und Videos.</p></section>
<section class="metric-grid"><article class="metric"><strong>{{data.channel_count}}</strong><span>Kanäle</span></article><article class="metric"><strong>{{data.total_views}}</strong><span>Views</span></article><article class="metric"><strong>{{data.total_likes}}</strong><span>Likes</span></article><article class="metric"><strong>{{data.total_comments}}</strong><span>Kommentare</span></article></section>
<section class="card"><h2>Aktuelle Kanal-Snapshots</h2>{{#if data.channel_analytics.length}}<div class="table-wrap"><table><tr><th>Kanal</th><th>Service</th><th>Views</th><th>Likes</th><th>Kommentare</th><th>Snapshot</th></tr>{{#each data.channel_analytics}}<tr><td>{{channel_id}}</td><td>{{service}}</td><td>{{views}}</td><td>{{likes}}</td><td>{{comments}}</td><td>{{timestamp}}</td></tr>{{/each}}</table></div>{{else}}<div class="empty-state"><p>Für deine Kanäle sind noch keine Analytics-Snapshots verfügbar.</p></div>{{/if}}</section>
<section class="card"><h2>Top-Videos nach Views</h2>{{#if data.video_analytics.length}}<div class="table-wrap"><table><tr><th>Video</th><th>Views</th><th>Likes</th><th>Kommentare</th><th>Snapshot</th></tr>{{#each data.video_analytics}}<tr><td>{{video_id}}</td><td>{{views}}</td><td>{{likes}}</td><td>{{comments}}</td><td>{{timestamp}}</td></tr>{{/each}}</table></div>{{else}}<div class="empty-state"><p>Für deine Videos sind noch keine Analytics-Snapshots verfügbar.</p></div>{{/if}}</section>