<section class="page-heading"><p class="eyebrow">Performance</p><h1>Analytics</h1><p>Auswertungen deiner verbundenen Kanäle und Videos. Die Werte gelten jeweils für den angegebenen Zeitraum.</p></section>
<section class="metric-grid"><article class="metric"><strong>{{formatNumber data.channel_count}}</strong><span>Kanäle</span></article><article class="metric"><strong>{{formatNumber data.total_views}}</strong><span>Views</span></article><article class="metric"><strong>{{formatNumber data.total_likes}}</strong><span>Likes</span></article><article class="metric"><strong>{{formatNumber data.total_comments}}</strong><span>Kommentare</span></article></section>
<section class="card"><h2>Aktuelle Kanal-Snapshots</h2>{{#if data.channel_analytics.length}}<div class="table-wrap"><table class="data-table"><thead><tr><th>Kanal</th><th>Service</th><th>Zeitraum</th><th>Views</th><th>Likes</th><th>Kommentare</th><th>Importiert</th></tr></thead><tbody>{{#each data.channel_analytics}}<tr><td>{{channel_name}}</td><td>{{> platform service=service}}</td><td>{{formatDateRange period_start period_end}}</td><td>{{formatNumber views}}</td><td>{{formatNumber likes}}</td><td>{{formatNumber comments}}</td><td>{{formatDateTime timestamp}}</td></tr>{{/each}}</tbody></table></div>{{else}}<div class="empty-state"><p>Für deine Kanäle sind noch keine Analytics-Snapshots verfügbar.</p></div>{{/if}}</section>
<section class="card"><h2>Top-Videos nach Views</h2>{{#if data.video_analytics.length}}<div class="table-wrap"><table class="data-table"><thead><tr><th>Video</th><th>Zeitraum</th><th>Views</th><th>Likes</th><th>Kommentare</th><th>Importiert</th></tr></thead><tbody>{{#each data.video_analytics}}<tr><td>{{video_title}}</td><td>{{formatDateRange period_start period_end}}</td><td>{{formatNumber views}}</td><td>{{formatNumber likes}}</td><td>{{formatNumber comments}}</td><td>{{formatDateTime timestamp}}</td></tr>{{/each}}</tbody></table></div>{{else}}<div class="empty-state"><p>Für deine Videos sind noch keine Analytics-Snapshots verfügbar.</p></div>{{/if}}</section>
