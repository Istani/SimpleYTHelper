<h2>{{{i18n "SYTH Account API"}}}</h2>
<p>{{{i18n "API-Keys geben ausschließlich Zugriff auf die Daten des eigenen SYTH-Accounts. Der Key wird nur beim Erstellen angezeigt."}}}</p>
{{#if data.created_key}}
  <div class="ui-state-highlight ui-corner-all" style="padding: 1em; margin-bottom: 1em;">
    <strong>Neuer API-Key — jetzt sicher speichern:</strong><br>
    <code>{{data.created_key}}</code>
  </div>
{{/if}}
<form method="POST" action="/Api/Keys">
  <input type="hidden" name="csrf_token" value="{{data.csrf_token}}">
  <label for="label">Bezeichnung</label>
  <input id="label" name="label" type="text" maxlength="100" required placeholder="z. B. Mein Dashboard">
  <input type="submit" value="API-Key erstellen">
</form>
<h3>Aktive und widerrufene Keys</h3>
{{#if data.keys.length}}
<table>
  <tr><th>Bezeichnung</th><th>Prefix</th><th>Erstellt</th><th>Letzte Nutzung</th><th>Status</th><th></th></tr>
  {{#each data.keys}}
    <tr>
      <td>{{label}}</td><td><code>{{key_prefix}}…</code></td><td>{{created_at}}</td><td>{{last_used_at}}</td>
      <td>{{#if revoked_at}}widerrufen{{else}}aktiv{{/if}}</td>
      <td>{{#unless revoked_at}}<form method="POST" action="/Api/Keys/{{id}}/Revoke"><input type="hidden" name="csrf_token" value="{{../data.csrf_token}}"><input type="submit" value="Widerrufen"></form>{{/unless}}</td>
    </tr>
  {{/each}}
</table>
{{else}}<p>Noch keine API-Keys angelegt.</p>{{/if}}
<p><a href="/Api/Docs">Zur API-Dokumentation</a></p>
