<h2>{{i18n "Members"}}</h2>

<section class="card">
    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>{{i18n "Service"}}</th>
                    <th>{{i18n "Title"}}</th>
                    <th>{{i18n "Level"}}</th>
                    <th>{{i18n "Since"}}</th>
                </tr>
            </thead>
            <tbody>
                {{#each data.members}}
                    <tr>
                        <td>
                            {{> platform service=service}}
                        </td>
                        <td>{{emojify member_name}}</td>
                        <td>{{level}}</td>
                        <td>{{since}}</td>
                    </tr>
                {{else}}
                    <tr>
                        <td colspan="4">{{i18n "No members found."}}</td>
                    </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
</section>
