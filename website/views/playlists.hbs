<section class="page-heading"><p class="eyebrow">Content-Hub</p><h1>Playlists</h1><p>{{data.total}} Playlists in deiner Bibliothek.</p></section><form class="search-form" method="GET"><input name="q" value="{{data.q}}" placeholder="Playlists durchsuchen"><button class="button primary" type="submit">Suchen</button></form><div class="content-grid">{{#each data.playlists}}<article class="card"><p class="eyebrow">{{service}}</p><h2>{{title}}</h2><p>{{description}}</p><p class="muted">ID: {{pl_id}}</p></article>{{else}}<div class="empty-state"><h2>Keine Playlists gefunden</h2><p>Ändere den Suchbegriff oder verbinde einen weiteren Kanal.</p></div>{{/each}}</div><nav class="pagination">{{#if data.has_previous}}<a class="button" href="?q={{data.q}}&page={{data.previous_page}}">← Zurück</a>{{/if}}<span>Seite {{data.page}} von {{data.page_count}}</span>{{#if data.has_next}}<a class="button" href="?q={{data.q}}&page={{data.next_page}}">Weiter →</a>{{/if}}</nav>