<section class="page-heading"><p class="eyebrow">Content-Hub</p><h1>Videos</h1><p>{{data.total}} Videos in deiner Bibliothek.</p></section><form class="search-form" method="GET"><input name="q" value="{{data.q}}" placeholder="Videos durchsuchen"><button class="button primary" type="submit">Suchen</button></form><div class="content-grid">{{#each data.videos}}<article class="card"><img loading="lazy" src="{{thumbnail}}" alt="" class="media-thumb"><h2>{{title}}</h2><p class="muted">{{service}} · {{publishedAt}}</p><p><strong>{{viewCount}}</strong> Views · {{likeCount}} Likes · {{commentCount}} Kommentare</p></article>{{else}}<div class="empty-state"><h2>Keine Videos gefunden</h2><p>Ändere den Suchbegriff oder verbinde einen weiteren Kanal.</p></div>{{/each}}</div><nav class="pagination">{{#if data.has_previous}}<a class="button" href="?q={{data.q}}&page={{data.previous_page}}">← Zurück</a>{{/if}}<span>Seite {{data.page}} von {{data.page_count}}</span>{{#if data.has_next}}<a class="button" href="?q={{data.q}}&page={{data.next_page}}">Weiter →</a>{{/if}}</nav>