<main class="content-library channels-page">
  <section class="page-heading">
    <p class="eyebrow">Content-Hub</p>
    <h1>Channels</h1>
    <p>{{data.total}} verbundene Channels.</p>
  </section>
  <form class="search-form" method="GET">
    <input name="q" value="{{data.q}}" placeholder="Channels durchsuchen" aria-label="Channels durchsuchen">
    <button class="button primary" type="submit">Suchen</button>
  </form>
  <div class="content-grid">
    {{#each data.channels}}
      <article class="card channel-card">
        {{#if banner}}<img class="channel-card__banner" loading="lazy" src="{{banner}}" alt="">{{/if}}
        <div class="channel-card__content">
          <img class="channel-card__avatar" loading="lazy" src="{{thumbnail}}" alt="{{channel_title}}">
          <div class="channel-card__heading"><span class="service-{{service}}">{{service}}</span><h2>{{emojify channel_title}}</h2></div>
          {{#if description}}<p class="channel-card__description">{{emojify description}}</p>{{else}}<p class="channel-card__description muted">Keine Beschreibung verfügbar.</p>{{/if}}
          <dl class="channel-card__stats"><div><dt>Abonnenten</dt><dd>{{subscriber}}</dd></div><div><dt>Aufrufe</dt><dd>{{views}}</dd></div><div><dt>Videos</dt><dd>{{videos}}</dd></div></dl>
          {{#if external_url}}<a class="channel-card__link" href="{{external_url}}" target="_blank" rel="noopener noreferrer">Channel auf {{external_service}} öffnen <span aria-hidden="true">↗</span></a>{{/if}}
        </div>
      </article>
    {{else}}
      <div class="empty-state"><h2>Keine Channels gefunden</h2><p>Ändere den Suchbegriff oder verbinde einen weiteren Channel.</p></div>
    {{/each}}
  </div>
  <nav class="pagination" aria-label="Channel-Seiten">
    {{#if data.has_previous}}<a class="button" href="?q={{data.q}}&page={{data.previous_page}}">← Zurück</a>{{/if}}
    <span>Seite {{data.page}} von {{data.page_count}}</span>
    {{#if data.has_next}}<a class="button" href="?q={{data.q}}&page={{data.next_page}}">Weiter →</a>{{/if}}
  </nav>
</main>
